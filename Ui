local Grid = {}
Grid.__index = Grid
function Grid.new(menu, parent, trove, spec)
    return setmetatable({
        _menu = menu,
        _trove = trove,
        _parent = parent,
        Columns = spec.Columns or 2,
        _realized = false,
        _fullPage = nil,
    }, Grid)
end
function Grid:_Build()
    if self._realized then return end
    self._realized = true
    if self._parent == nil then return end
    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.Size = UDim2.fromScale(1, 1)
    scroll.BorderSizePixel = 0
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = Tokens.Accent
    scroll.Parent = self._parent
    local layout = Instance.new("UIGridLayout")
    layout.CellSize = UDim2.new(0.5, -6, 0, 0)
    layout.CellPadding = UDim2.fromOffset(12, 12)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.FillDirectionMaxCells = self.Columns
    layout.Parent = scroll
    self._fullPage = scroll
end
function Grid:AddSection(spec)
    self:_Build()
    local self2 = self
    local section = Section.new(self._menu, self._trove:Extend(), spec, function()
        return self2._fullPage
    end)
    section:_Realize()
    return section
end
function Grid:Realize() self:_Build() end

local Tab = {}
Tab.__index = Tab
function Tab.new(menu, parent, trove, spec)
    return setmetatable({
        _menu = menu,
        _trove = trove,
        Label = spec.Label or "Tab",
        _parent = parent,
        _page = nil,
        _realized = false,
    }, Tab)
end
function Tab:_Build(pageFrame)
    if self._realized then return end
    self._realized = true
    local page = Instance.new("Frame")
    page.BackgroundTransparency = 1
    page.Size = UDim2.fromScale(1, 1)
    page.BorderSizePixel = 0
    page.Parent = pageFrame
    page.Visible = false
    self._page = page
end
function Tab:Grid(spec)
    self:_Build(self._parent._pageFrame)
    return Grid.new(self._menu, self._page, self._trove, spec or {})
end
function Tab:SetVisible(v)
    if self._page then self._page.Visible = v end
end

