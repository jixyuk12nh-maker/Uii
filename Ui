    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.BorderSizePixel = 0
    root.Active = true
    root.Draggable = true
    root.Parent = gui
    Instance.new("UICorner", root).CornerRadius = UDim.new(0, 8)
