        gui.Enabled = false
    end)
    table.insert(K.cleanups, function() pcall(function() gui:Destroy() end) end)

    return menu
end
function Menu:AddTab(spec)
    local tab = Tab.new(self, self, self._trove:Extend(), spec)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(90, 24)
    btn.BackgroundColor3 = Tokens.ElementBackground
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.LayoutOrder = #self._tabs + 1
    btn.Parent = self._tabsBar
    newCorner(btn, 5)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Text = spec.Label or "Tab"
    label.TextSize = 14
    label.TextColor3 = Tokens.Unselected
    label.FontFace = Fonts.Main
    label.Parent = btn
    tab._button = btn
    tab._label = label

    table.insert(self._tabs, tab)
    tab:_Build(self._pageFrame)

    local self2 = self
    self._trove:Connect(btn.MouseButton1Click, function()
        for _, t in ipairs(self2._tabs) do
            t:SetVisible(false)
            t._label.TextColor3 = Tokens.Unselected
            t._button.BackgroundColor3 = Tokens.ElementBackground
        end
        tab:SetVisible(true)
        tab._label.TextColor3 = Tokens.Accent
        tab._button.BackgroundColor3 = Tokens.TabButtonSelected
        self2._currentTab = tab
    end)

    if self._currentTab == nil then
        for _, t in ipairs(self._tabs) do t:SetVisible(false) end
        tab:SetVisible(true)
        tab._label.TextColor3 = Tokens.Accent
        tab._button.BackgroundColor3 = Tokens.TabButtonSelected
        self._currentTab = tab
    end
    return tab
end
function Menu:SetVisible(v) self._gui.Enabled = v end
function Menu:Destroy()
    self._trove:Destroy()
    self._gui:Destroy()
end

local function fetchWidget(name)
    local src = game:HttpGet(BASE .. name .. ".lua")
    local fn = loadstring(src, "KiciaUI/" .. name .. ".lua")
    return fn(Core)
end

Section._Factories.Toggle      = fetchWidget("toggle")
Section._Factories.Button      = fetchWidget("button")
Section._Factories.Label       = fetchWidget("label")
Section._Factories.Divider     = fetchWidget("divider")
Section._Factories.Slider      = fetchWidget("slider")
Section._Factories.TextBox     = fetchWidget("textbox")
Section._Factories.Dropdown    = fetchWidget("dropdown")
Section._Factories.ColorPicker = fetchWidget("colorpicker")
Section._Factories.Keybind     = fetchWidget("keybind")

K.newMenu = function(spec) return Menu.new(spec or {}) end
K.Tokens = Tokens
K.Unload = function()
    if K.destroyed then return end
    K.destroyed = true
    for _, f in ipairs(K.cleanups) do pcall(f) end
    if getgenv().KiciaUI == K then getgenv().KiciaUI = nil end
end

return K
