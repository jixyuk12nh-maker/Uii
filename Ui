--==========================================================================
--  Kicia UI — Main Frame
--  Window / Tab / Grid / Section 시스템
--  위젯은 widgets/*.lua 에서 불러와서 Section 메서드로 붙임
--==========================================================================
local BASE = "https://cdn.jsdelivr.net/gh/jixyuk12nh-maker/Uii@main/"

-- 이미 로드된 인스턴스 있으면 정리
if getgenv().KiciaUI and getgenv().KiciaUI.Unload then
    pcall(getgenv().KiciaUI.Unload)
end

local function fetch(rel)
    local url = BASE .. rel
    local src = game:HttpGet(url)
    assert(#src > 0, "KiciaUI: empty response for " .. url)
    local fn, err = loadstring(src, "KiciaUI/" .. rel)
    assert(fn, "KiciaUI: compile error in " .. rel .. ": " .. tostring(err))
    return fn()
end

--==========================================================================
--  코어 로드
--==========================================================================
local Core = fetch("lib/core.lua")
local Signal = Core.Signal
local Trove = Core.Trove
local Tokens = Core.Tokens
local Batch = Core.Batch
local Util = Core.Util

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local K = { destroyed = false, cleanups = {} }
getgenv().KiciaUI = K

function K.onUnload(f) table.insert(K.cleanups, f) end

--==========================================================================
--  Row (행 컨테이너 — 모든 위젯의 부모)
--==========================================================================
local Row = {}
Row.__index = Row
function Row.new(menu, spec)
    return setmetatable({
        _menu = menu, _height = spec.Height or 24, _visible = true,
        _attachments = {}, Label = spec.Label, _bare = spec.Bare == true,
        Frame = nil, _rightOffset = spec.RightOffset or 0,
    }, Row)
end
function Row:AttachRight(build, width)
    local a = { Build = build, Width = width, Widget = nil }
    table.insert(self._attachments, a)
    return a
end
function Row:Realize(parent, ctx, order)
    local frame = Instance.new("TextButton")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, self._height)
    frame.BorderSizePixel = 0
    frame.AutomaticSize = Enum.AutomaticSize.Y
    frame.AutoButtonColor = false
    frame.Text = ""
    frame.LayoutOrder = order
    frame.Visible = self._visible
    frame.Parent = parent
    self.Frame = frame

    local label = Instance.new("TextLabel")
    label.Text = self.Label or ""
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromOffset(0, 2)
    label.Size = UDim2.fromOffset(0, self._height - 4)
    label.AutomaticSize = Enum.AutomaticSize.X
    label.TextSize = 16
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.FontFace = ctx.Menu.Fonts.Main
    label.BorderSizePixel = 0
    ctx.Batch:Bind(label, "TextColor3", "TextColor")
    label.Parent = frame
    self.TitleLabel = label

    local right = Instance.new("Frame")
    right.BackgroundTransparency = 1
    right.AnchorPoint = Vector2.new(1, 0)
    right.Position = UDim2.new(1, self._rightOffset, 0, 0)
    right.Size = UDim2.new(0.55, 0, 0, self._height)
    right.BorderSizePixel = 0
    right.Parent = frame
    self.Right = right

    for _, a in ipairs(self._attachments) do
        if a.Widget == nil then
            a.Widget = a.Build(right, ctx)
        end
    end
end
function Row:SetVisible(v)
    if self._visible == v then return end
    self._visible = v
    if self.Frame then self.Frame.Visible = v end
end
function Row:SetLabel(l)
    self.Label = l
    if self.TitleLabel then self.TitleLabel.Text = l end
end

--==========================================================================
--  Section (엘리먼트 나열 컨테이너)
--==========================================================================
local Section = {}
Section.__index = Section
function Section.new(menu, trove, spec, resolveParent)
    return setmetatable({
        _menu = menu, _trove = trove, Title = spec.Title or "",
        _side = spec.Side or "left", _resolveParent = resolveParent,
        _entries = {}, _realized = false, _elements = nil, _rootFrame = nil,
    }, Section)
end
function Section:_Realize()
    if self._realized then return end
    self._realized = true
    local parent = self._resolveParent and self._resolveParent() or nil
    if parent == nil then return end

    local root = Instance.new("Frame")
    root.BackgroundTransparency = 1
    root.Size = UDim2.new(1, 0, 0, 0)
    root.AutomaticSize = Enum.AutomaticSize.Y
    root.BorderSizePixel = 0
    root.LayoutOrder = #parent:GetChildren() + 1
    root.Parent = parent
    self._rootFrame = root

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = root

    if self.Title ~= "" then
        local title = Instance.new("TextLabel")
        title.Text = self.Title
        title.BackgroundTransparency = 1
        title.Size = UDim2.new(1, 0, 0, 16)
        title.TextSize = 15
        title.TextColor3 = Tokens.TextColor
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.FontFace = self._menu.Fonts.SemiBold
        title.LayoutOrder = 0
        title.Parent = root
    end

    local box = Instance.new("Frame")
    box.BackgroundColor3 = Tokens.GradientMid
    box.Size = UDim2.new(1, 0, 0, 0)
    box.AutomaticSize = Enum.AutomaticSize.Y
    box.BorderSizePixel = 0
    box.LayoutOrder = 1
    box.Parent = root
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", box)
    stroke.Color = Tokens.Outline

    local pad = Instance.new("UIPadding", box)
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)

    local elements = Instance.new("Frame")
    elements.BackgroundTransparency = 1
    elements.Size = UDim2.new(1, 0, 0, 0)
    elements.AutomaticSize = Enum.AutomaticSize.Y
    elements.BorderSizePixel = 0
    elements.Parent = box
    local elayout = Instance.new("UIListLayout", elements)
    elayout.Padding = UDim.new(0, 6)
    elayout.SortOrder = Enum.SortOrder.LayoutOrder
    self._elements = elements

    local ctx = { Menu = self._menu, Batch = Batch.newBatch(self._trove) }
    for i, entry in ipairs(self._entries) do
        entry.Row:Realize(elements, ctx, i)
    end
end
function Section:_AddRow(row, spec)
    table.insert(self._entries, { Row = row, Spec = spec })
    if self._realized then
        local ctx = { Menu = self._menu, Batch = Batch.newBatch(self._trove) }
        row:Realize(self._elements, ctx, #self._entries)
    end
    return row
end

--  위젯 팩토리 (widgets/*.lua 가 여기로 주입됨)
Section._Factories = {}
function Section:AddToggle(spec)
    local row = Row.new(self._menu, { Label = spec.Label, Tooltip = spec.Tooltip })
    self:_AddRow(row, spec)
    return Section._Factories.Toggle(self._menu, row, self._trove:Extend(), spec)
end
function Section:AddButton(spec)
