local Toggle = {}
Toggle.__index = Toggle
local function makeToggle(menu, row, trove, spec)
    local obj = setmetatable({
        _trove = trove, _menu = menu, Row = row,
        Value = spec.Default == true, Changed = Signal.new(),
        _onChanged = spec.OnChanged or function() end, _rt = nil,
    }, Toggle)
    row:AttachRight(function(parent)
        local track = Instance.new("Frame")
        track.AnchorPoint = Vector2.new(1, 0.5)
        track.Position = UDim2.fromScale(1, 0.5)
        track.Size = UDim2.fromOffset(32, 20)
        track.BorderSizePixel = 0
        track.BackgroundColor3 = Tokens.ToggleBackgroundUnselected
        track.Parent = parent
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.fromScale(1, 1)
        fill.BorderSizePixel = 0
        fill.BackgroundColor3 = Tokens.Accent
        fill.BackgroundTransparency = 1
        fill.Parent = track
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
        local circle = Instance.new("Frame")
        circle.Position = UDim2.fromOffset(3, 2)
        circle.Size = UDim2.fromOffset(16, 16)
        circle.BorderSizePixel = 0
        circle.BackgroundColor3 = Tokens.ToggleCircleUnselected
        circle.Parent = track
        Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
        obj._rt = { Track = track, Fill = fill, Circle = circle }
        local function apply(v, instant)
            if instant then
                fill.BackgroundTransparency = v and 0 or 1
                circle.BackgroundColor3 = v and Tokens.Accent or Tokens.ToggleCircleUnselected
                circle.Position = v and UDim2.fromOffset(13, 2) or UDim2.fromOffset(3, 2)
                return
            end
            local info = TweenInfo.new(0.1)
            TweenService:Create(fill, info, { BackgroundTransparency = v and 0 or 1 }):Play()
            TweenService:Create(circle, info, {
                BackgroundColor3 = v and Tokens.Accent or Tokens.ToggleCircleUnselected,
                Position = v and UDim2.fromOffset(13, 2) or UDim2.fromOffset(3, 2),
            }):Play()
        end
        apply(obj.Value, true)
        trove:Connect(obj.Changed, function(v) apply(v) end)
        trove:Connect(obj.Row.Frame.InputBegan, function(input)
            local t = input.UserInputType
            if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
                obj:Set(not obj.Value)
            end
        end)
        return track
    end, 32)
    return obj
end
function Toggle:Set(v, instant)
    if type(v) ~= "boolean" or v == self.Value then return end
    self.Value = v
    if instant then
        local rt = self._rt
        if rt then
            rt.Fill.BackgroundTransparency = v and 0 or 1
            rt.Circle.BackgroundColor3 = v and Tokens.Accent or Tokens.ToggleCircleUnselected
            rt.Circle.Position = v and UDim2.fromOffset(13, 2) or UDim2.fromOffset(3, 2)
        end
    else
        self.Changed:Fire(v)
        self._onChanged(v)
    end
end
function Toggle:SetVisible(v) self.Row:SetVisible(v) end
function Toggle:OnChanged(fn) self._trove:Connect(self.Changed, fn) return self end

