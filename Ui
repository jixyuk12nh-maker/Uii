local BASE = "https://cdn.jsdelivr.net/gh/jixyuk12nh-maker/Uii@main/"

if getgenv().KiciaUI and getgenv().KiciaUI.Unload then
    pcall(getgenv().KiciaUI.Unload)
end

local K = { destroyed = false, cleanups = {} }
getgenv().KiciaUI = K

local Core = Core or (function()
    local src = game:HttpGet(BASE .. "core.lua")
    local fn = loadstring(src, "KiciaUI/core.lua")
    return fn()
end)()

local Signal = Core.Signal
local Trove = Core.Trove
local Tokens = Core.Tokens
local Fonts = Core.Fonts
local newCorner = Core.newCorner
local newStroke = Core.newStroke

local Row = {}
Row.__index = Row
function Row.new(menu, spec)
    return setmetatable({
        _menu = menu,
        _height = spec.Height or 26,
        _visible = true,
        _attachments = {},
        Label = spec.Label,
        Frame = nil,
        _rightOffset = spec.RightOffset or 0,
    }, Row)
end
function Row:AttachRight(build)
    local a = { Build = build, Widget = nil }
    table.insert(self._attachments, a)
    return a
end
function Row:Realize(parent, ctx, order)
    local frame = Instance.new("TextButton")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, self._height)
    frame.BorderSizePixel = 0
    frame.Text = ""
    frame.AutoButtonColor = false
    frame.LayoutOrder = order
    frame.Visible = self._visible
    frame.Parent = parent
    self.Frame = frame

    local label = Instance.new("TextLabel")
    label.Text = self.Label or ""
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromOffset(0, 0)
    label.Size = UDim2.new(0.4, 0, 1, 0)
    label.TextSize = 15
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.FontFace = ctx.Menu.Fonts.Main
    label.TextColor3 = Tokens.TextColor
    label.BorderSizePixel = 0
    label.Parent = frame
    self.TitleLabel = label

    local right = Instance.new("Frame")
    right.BackgroundTransparency = 1
    right.AnchorPoint = Vector2.new(1, 0)
    right.Position = UDim2.new(1, self._rightOffset, 0, 0)
    right.Size = UDim2.new(0.6, -8, 1, 0)
    right.BorderSizePixel = 0
    right.Parent = frame
    self.Right = right

    for _, a in ipairs(self._attachments) do
        if a.Widget == nil then
            a.Widget = a.Build(right, ctx)
        end
    end
end
function Row:SetVisible(v)
    if self._visible == v then return end
    self._visible = v
    if self.Frame then self.Frame.Visible = v end
end
function Row:SetLabel(l)
    self.Label = l
    if self.TitleLabel then self.TitleLabel.Text = l end
end

local Section = {}
Section.__index = Section
function Section.new(menu, trove, spec, resolveParent)
    return setmetatable({
        _menu = menu,
        _trove = trove,
        Title = spec.Title or "",
        _side = spec.Side or "left",
        _resolveParent = resolveParent,
        _entries = {},
        _realized = false,
        _elements = nil,
        _rootFrame = nil,
        _ctx = nil,
    }, Section)
end
function Section:_Ctx()
    if self._ctx == nil then
        self._ctx = { Menu = self._menu, Batch = nil }
    end
    return self._ctx
end
function Section:_Realize()
    if self._realized then return end
    self._realized = true
    local parent = self._resolveParent and self._resolveParent() or nil
    if parent == nil then return end

    local root = Instance.new("Frame")
    root.BackgroundTransparency = 1
    root.Size = UDim2.new(1, 0, 0, 0)
    root.AutomaticSize = Enum.AutomaticSize.Y
    root.BorderSizePixel = 0
    root.LayoutOrder = #parent:GetChildren() + 1
    root.Parent = parent
    self._rootFrame = root

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = root

    if self.Title ~= "" then
        local title = Instance.new("TextLabel")
        title.Text = self.Title
        title.BackgroundTransparency = 1
        title.Size = UDim2.new(1, 0, 0, 16)
        title.TextSize = 15
        title.TextColor3 = Tokens.TextColor
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.FontFace = Fonts.SemiBold
        title.LayoutOrder = 0
        title.Parent = root
    end

    local box = Instance.new("Frame")
    box.BackgroundColor3 = Tokens.GradientMid
    box.Size = UDim2.new(1, 0, 0, 0)
    box.AutomaticSize = Enum.AutomaticSize.Y
    box.BorderSizePixel = 0
    box.LayoutOrder = 1
    box.Parent = root
    newCorner(box, 6)
    newStroke(box)

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = box

    local elements = Instance.new("Frame")
    elements.BackgroundTransparency = 1
    elements.Size = UDim2.new(1, 0, 0, 0)
    elements.AutomaticSize = Enum.AutomaticSize.Y
    elements.BorderSizePixel = 0
    elements.Parent = box
    local elayout = Instance.new("UIListLayout")
    elayout.Padding = UDim.new(0, 6)
    elayout.SortOrder = Enum.SortOrder.LayoutOrder
    elayout.Parent = elements
    self._elements = elements

    local ctx = self:_Ctx()
    for i, entry in ipairs(self._entries) do
        entry.Row:Realize(elements, ctx, i)
    end
end
function Section:_AddRow(row, spec)
    table.insert(self._entries, { Row = row, Spec = spec })
    if self._realized then
        local ctx = self:_Ctx()
        row:Realize(self._elements, ctx, #self._entries)
    end
    return row
end

Section._Factories = {}

function Section:AddToggle(spec)
    local row = Row.new(self._menu, { Label = spec.Label })
    self:_AddRow(row, spec)
    return Section._Factories.Toggle(self._menu, row, self._trove:Extend(), spec)
end
function Section:AddButton(spec)
    local row = Row.new(self._menu, { Label = spec.Label })
