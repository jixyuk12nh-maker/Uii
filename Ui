    close.Size = UDim2.fromOffset(22, 22)
    close.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
    close.Text = "x"
    close.TextSize = 14
    close.TextColor3 = Color3.new(1, 1, 1)
    close.FontFace = Fonts.Bold
    close.AutoButtonColor = false
    close.BorderSizePixel = 0
    close.Parent = titleBar
    newCorner(close, 5)

    local tabsBar = Instance.new("ScrollingFrame")
    tabsBar.Position = UDim2.fromOffset(0, 34)
    tabsBar.Size = UDim2.new(1, 0, 0, 34)
    tabsBar.BackgroundColor3 = Tokens.GradientMid
    tabsBar.BorderSizePixel = 0
    tabsBar.ScrollBarThickness = 0
    tabsBar.ScrollingDirection = Enum.ScrollingDirection.X
    tabsBar.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabsBar.AutomaticCanvasSize = Enum.AutomaticSize.X
    tabsBar.Parent = root
    local tabsLayout = Instance.new("UIListLayout")
    tabsLayout.FillDirection = Enum.FillDirection.Horizontal
    tabsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabsLayout.Padding = UDim.new(0, 6)
    tabsLayout.Parent = tabsBar
    local tabsPad = Instance.new("UIPadding")
    tabsPad.PaddingLeft = UDim.new(0, 8)
    tabsPad.PaddingRight = UDim.new(0, 8)
    tabsPad.Parent = tabsBar

    local pageFrame = Instance.new("Frame")
    pageFrame.Position = UDim2.fromOffset(0, 68)
    pageFrame.Size = UDim2.new(1, 0, 1, -68)
    pageFrame.BackgroundTransparency = 1
    pageFrame.BorderSizePixel = 0
    pageFrame.Parent = root

    local menu = setmetatable({
        _trove = trove,
        _gui = gui,
        _root = root,
        _tabsBar = tabsBar,
        _pageFrame = pageFrame,
        _tabs = {},
        _currentTab = nil,
        Fonts = Fonts,
    }, Menu)

