    local close = Instance.new("TextButton")
    close.AnchorPoint = Vector2.new(1, 0.5)
    close.Position = UDim2.new(1, -8, 0.5, 0)
    close.Size = UDim2.fromOffset(22, 22)
    close.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
    close.Text = "x"
    close.TextSize = 14
    close.TextColor3 = Color3.new(1, 1, 1)
    close.FontFace = Core.Fonts.Bold
    close.AutoButtonColor = false
    close.BorderSizePixel = 0
    close.Parent = titleBar
    Instance.new("UICorner", close).CornerRadius = UDim.new(0, 5)

    -- 탭바
    local tabsBar = Instance.new("ScrollingFrame")
    tabsBar.Position = UDim2.fromOffset(0, 34)
    tabsBar.Size = UDim2.new(1, 0, 0, 34)
    tabsBar.BackgroundColor3 = Tokens.GradientMid
    tabsBar.BorderSizePixel = 0
    tabsBar.ScrollBarThickness = 0
    tabsBar.ScrollingDirection = Enum.ScrollingDirection.X
    tabsBar.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabsBar.AutomaticCanvasSize = Enum.AutomaticSize.X
    tabsBar.Parent = root
    local tabsLayout = Instance.new("UIListLayout", tabsBar)
    tabsLayout.FillDirection = Enum.FillDirection.Horizontal
    tabsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabsLayout.Padding = UDim.new(0, 6)
    local tabsPad = Instance.new("UIPadding", tabsBar)
    tabsPad.PaddingLeft = UDim.new(0, 8)
    tabsPad.PaddingRight = UDim.new(0, 8)

    -- 페이지 프레임
    local pageFrame = Instance.new("Frame")
    pageFrame.Position = UDim2.fromOffset(0, 68)
    pageFrame.Size = UDim2.new(1, 0, 1, -68)
    pageFrame.BackgroundTransparency = 1
    pageFrame.BorderSizePixel = 0
    pageFrame.Parent = root

    local menu = setmetatable({
        _trove = trove, _gui = gui, _root = root, _tabsBar = tabsBar,
        _pageFrame = pageFrame, _tabs = {}, _currentTab = nil,
        Fonts = Core.Fonts,
    }, Menu)

    trove:Connect(close.MouseButton1Click, function()
        gui.Enabled = false
    end)
    K.onUnload(function() pcall(function() gui:Destroy() end) end)
    return menu
end
function Menu:AddTab(spec)
    local tab = Tab.new(self, self, self._trove:Extend(), spec)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(90, 24)
    btn.BackgroundColor3 = Tokens.ElementBackground
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.LayoutOrder = #self._tabs + 1
    btn.Parent = self._tabsBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Text = spec.Label or "Tab"
    label.TextSize = 14
    label.TextColor3 = Tokens.Unselected
    label.FontFace = self.Fonts.Medium
    label.Parent = btn
    tab._button = btn
    tab._label = label

    table.insert(self._tabs, tab)
    tab:_Build(self._pageFrame)

    local self2 = self
    self._trove:Connect(btn.MouseButton1Click, function()
        for _, t in ipairs(self2._tabs) do
            t:SetVisible(false)
            t._label.TextColor3 = Tokens.Unselected
            t._button.BackgroundColor3 = Tokens.ElementBackground
        end
        tab:SetVisible(true)
        tab._label.TextColor3 = Tokens.Accent
        tab._button.BackgroundColor3 = Tokens.TabButtonSelected
        self2._currentTab = tab
    end)

    if self._currentTab == nil then
        for _, t in ipairs(self._tabs) do t:SetVisible(false) end
        tab:SetVisible(true)
        tab._label.TextColor3 = Tokens.Accent
        tab._button.BackgroundColor3 = Tokens.TabButtonSelected
        self._currentTab = tab
    end
    return tab
end
function Menu:SetVisible(v) self._gui.Enabled = v end
function Menu:Destroy()
    self._trove:Destroy()
    self._gui:Destroy()
end

--==========================================================================
--  위젯 로드 및 팩토리 주입
--==========================================================================
local Basic   = fetch("widgets/basic.lua")(Core)
local Input   = fetch("widgets/input.lua")(Core)
local Misc    = fetch("widgets/misc.lua")(Core)

Section._Factories = {
    Toggle      = Basic.Toggle,
    Button      = Basic.Button,
    Label       = Basic.Label,
    Divider     = Basic.Divider,
    Slider      = Input.Slider,
    TextBox     = Input.TextBox,
    Dropdown    = Input.Dropdown,
    ColorPicker = Misc.ColorPicker,
    Keybind     = Misc.Keybind,
}

--==========================================================================
--  공개 API
--==========================================================================
K.newMenu = function(spec) return Menu.new(spec or {}) end
K.Tokens = Tokens
K.refreshToken = Batch.refresh
K.Unload = function()
    if K.destroyed then return end
    K.destroyed = true
    for _, f in ipairs(K.cleanups) do pcall(f) end
    if getgenv().KiciaUI == K then getgenv().KiciaUI = nil end
end

return K
