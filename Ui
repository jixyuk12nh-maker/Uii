    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.BorderSizePixel = 0
    root.Active = true
    root.Draggable = true
    root.Parent = gui
    newCorner(root, 8)
    newStroke(root)

    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 34)
